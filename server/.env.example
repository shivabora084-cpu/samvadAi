# SamvadAI Server Configuration

# Server
PORT=5000
NODE_ENV=development

# Database (Supabase PostgreSQL - Session Pooler URI)
# Format: postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.sample:samplepassword@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Authentication
JWT_SECRET=samvadai_super_secret_jwt_key_at_least_32_chars_long_production_quality
JWT_EXPIRES_IN=7d

# CORS / Allowed Client Origins (comma-separated for multiple)
CLIENT_URL=http://localhost:5173

# AI Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Seeding & Admin Credentials
SEED_ADMIN_PASSWORD=Admin@Samvad2025!

# Optional Providers (if swapping from Gemini)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TTS_PROVIDER=
